---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Månadens HVO">
  <div class="banner h-72 lg:h-96 px-4">
    <div class="h-48 lg:h-60"></div>
    <div class="max-w-screen-lg mx-auto flex flex-row items-end">
      <h1 class="text-6xl lg:text-[120px] grow text-neutral-800 font-bold">
        HVO
      </h1>
      <svg
        class="text-neutral-800 w-14 h-14 lg:w-28 lg:h-28"
        fill="currentColor"
        stroke-width="0"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 512 512"
        height="1em"
        width="1em"
        style="overflow: visible; --darkreader-inline-fill: currentColor;"
        data-darkreader-inline-fill=""
        ><path
          d="M32 64C32 28.7 60.7 0 96 0h160c35.3 0 64 28.7 64 64v192h8c48.6 0 88 39.4 88 88v32c0 13.3 10.7 24 24 24s24-10.7 24-24V222c-27.6-7.1-48-32.2-48-62V96l-32-32c-8.8-8.8-8.8-23.2 0-32s23.2-8.8 32 0l77.3 77.3c12 12 18.7 28.3 18.7 45.3V376c0 39.8-32.2 72-72 72s-72-32.2-72-72v-32c0-22.1-17.9-40-40-40h-8v144c17.7 0 32 14.3 32 32s-14.3 32-32 32H32c-17.7 0-32-14.3-32-32s14.3-32 32-32V64zm64 16v96c0 8.8 7.2 16 16 16h128c8.8 0 16-7.2 16-16V80c0-8.8-7.2-16-16-16H112c-8.8 0-16 7.2-16 16z"
        ></path></svg
      >
    </div>
  </div>
  <main class="max-w-screen-lg mx-auto text-[#ca7131] px-4">
    <div class="h-16"></div>
    
    <!-- Today's Prices -->
    <div class="flex flex-col lg:flex-row lg:items-center gap-8">
      <div class="grow">
        <h2 class="text-5xl lg:text-6xl font-semibold mb-4">Pris idag</h2>
        
        <!-- HVO 100 -->
        <div class="mb-6">
          <h3 class="text-2xl lg:text-3xl font-medium mb-2 text-[#ca7131]">HVO 100</h3>
          <p id="todayHvoPrice" class="text-3xl lg:text-4xl">-</p>
          <div class="h-2" />
          <p id="todayHvoExVAT" class="text-3xl lg:text-4xl">-</p>
        </div>
        
        <!-- Diesel -->
        <div>
          <h3 class="text-2xl lg:text-3xl font-medium mb-2 text-gray-400">Diesel</h3>
          <p id="todayDieselPrice" class="text-3xl lg:text-4xl text-gray-400">-</p>
          <div class="h-2" />
          <p id="todayDieselExVAT" class="text-3xl lg:text-4xl text-gray-400">-</p>
        </div>
      </div>
      
      <!-- Average Prices -->
      <div class="bg-stone-700/20 p-8 rounded-xl shadow-xl">
        <h2 class="text-4xl font-semibold">
          Snittpris
        </h2>
        <div class="h-6" />
        <div class="flex flex-row gap-4">
          <p id="monthBefore" class="text-2xl font-bold cursor-pointer select-none">&lt;</p>
          <h2 id="avgHeader" class="text-2xl font-semibold grow w-56">
            Denna månad
          </h2>
          <p id="monthAfter" class="text-2xl font-bold cursor-pointer">&gt;</p>
        </div>
        
        <!-- HVO Average -->
        <div class="mb-4">
          <h4 class="text-lg font-medium text-[#ca7131] mb-1">HVO 100</h4>
          <p id="monthPriceHvo">-</p>
          <p id="monthPriceHvoExVAT">-</p>
        </div>
        
        <!-- Diesel Average -->
        <div class="mb-4">
          <h4 class="text-lg font-medium text-gray-400 mb-1">Diesel</h4>
          <p id="monthPriceDiesel" class="text-gray-400">-</p>
          <p id="monthPriceDieselExVAT" class="text-gray-400">-</p>
        </div>
        
        <div class="h-4" />
        <h2 class="text-2xl font-semibold">Senaste 30 dagarna</h2>
        
        <!-- HVO 30 Day -->
        <div class="mb-4">
          <h4 class="text-lg font-medium text-[#ca7131] mb-1">HVO 100</h4>
          <p id="30dayPriceHvo">-</p>
          <p id="30dayPriceHvoExVAT">-</p>
        </div>
        
        <!-- Diesel 30 Day -->
        <div>
          <h4 class="text-lg font-medium text-gray-400 mb-1">Diesel</h4>
          <p id="30dayPriceDiesel" class="text-gray-400">-</p>
          <p id="30dayPriceDieselExVAT" class="text-gray-400">-</p>
        </div>
      </div>
    </div>

    <div class="h-8"></div>
    <div class="bg-stone-700/20 p-4 rounded-xl shadow-xl">
      <div id="priceHistory"></div>
      <div class="flex flex-row flex-wrap gap-8 mt-4 ml-4">
        <button id="graphWidth30" class="active-graph-duration p-4 rounded transition-colors">30 dagar</button>
        <button id="graphWidth90" class="p-4 rounded transition-colors">90 dagar</button>
        <button id="graphWidth365" class="p-4 rounded transition-colors">1 år</button>
      </div>
    </div>
    <div class="h-32"></div>
  </main>


  <script src="https://cdn.plot.ly/plotly-2.26.0.min.js" charset="utf-8"
  ></script>

  <script>
    import { removeVAT } from "../price";

    // Fetch today's prices
    let response = await fetch("/api/today");
    if (response.ok) {
      const todayData = await response.json();

      // HVO 100 prices
      const todayHvoPrice = document.getElementById("todayHvoPrice");
      if (todayHvoPrice && todayData.hvo100Price) {
        todayHvoPrice.innerText = todayData.hvo100Price + " kr/l (inkl. moms)";
      } else if (todayHvoPrice) {
        todayHvoPrice.innerText = "Ej tillgängligt";
      }

      const todayHvoExVAT = document.getElementById("todayHvoExVAT");
      if (todayHvoExVAT && todayData.hvo100Price) {
        todayHvoExVAT.innerText =
          removeVAT(todayData.hvo100Price).toFixed(2) + " kr/l (exkl. moms)";
      }

      // Diesel prices
      const todayDieselPrice = document.getElementById("todayDieselPrice");
      if (todayDieselPrice && todayData.dieselPrice) {
        todayDieselPrice.innerText = todayData.dieselPrice + " kr/l (inkl. moms)";
      } else if (todayDieselPrice) {
        todayDieselPrice.innerText = "Ej tillgängligt";
      }

      const todayDieselExVAT = document.getElementById("todayDieselExVAT");
      if (todayDieselExVAT && todayData.dieselPrice) {
        todayDieselExVAT.innerText =
          removeVAT(todayData.dieselPrice).toFixed(2) + " kr/l (exkl. moms)";
      }
    }

    let now = new Date();
    let thirtyDaysAgo = new Date(now);
    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

    let startOfMonth = new Date(now);
    startOfMonth.setDate(1);

    async function updateAggregatePrice(
      idHvo: string,
      idDiesel: string,
      date: Date,
      vat: boolean
    ) {
      let monthResp = await fetch(
        `/api/price/${date.getFullYear()}-${
          date.getMonth() + 1
        }-${date.getDate()}`,
      );
      if (monthResp.ok) {
        const latestData: any[] = await monthResp.json();

        // Calculate HVO 100 average (excluding null values)
        const hvoPrices = latestData
          .filter((x) => x.hvo100Price != null)
          .map((x) => x.hvo100Price);
        let avgHvo = hvoPrices.length > 0
          ? hvoPrices.reduce((acc, price) => acc + price, 0) / hvoPrices.length
          : null;
        
        // Calculate Diesel average (excluding null values)
        const dieselPrices = latestData
          .filter((x) => x.dieselPrice != null)
          .map((x) => x.dieselPrice);
        let avgDiesel = dieselPrices.length > 0
          ? dieselPrices.reduce((acc, price) => acc + price, 0) / dieselPrices.length
          : null;

        if (!vat) {
          if (avgHvo !== null) avgHvo = removeVAT(avgHvo);
          if (avgDiesel !== null) avgDiesel = removeVAT(avgDiesel);
        }

        // Update HVO price display
        const priceHvo = document.getElementById(idHvo);
        if (priceHvo != null) {
          if (avgHvo !== null) {
            priceHvo.innerText = avgHvo.toFixed(2) + " kr/l";
            if (vat) {
              priceHvo.innerText += " (inkl. moms)";
            } else {
              priceHvo.innerText += " (exkl. moms)";
            }
          } else {
            priceHvo.innerText = "-";
          }
        }

        // Update Diesel price display
        const priceDiesel = document.getElementById(idDiesel);
        if (priceDiesel != null) {
          if (avgDiesel !== null) {
            priceDiesel.innerText = avgDiesel.toFixed(2) + " kr/l";
            if (vat) {
              priceDiesel.innerText += " (inkl. moms)";
            } else {
              priceDiesel.innerText += " (exkl. moms)";
            }
          } else {
            priceDiesel.innerText = "-";
          }
        }
      }
    }

    // Update all aggregate prices
    updateAggregatePrice("monthPriceHvo", "monthPriceDiesel", startOfMonth, true);
    updateAggregatePrice("monthPriceHvoExVAT", "monthPriceDieselExVAT", startOfMonth, false);
    updateAggregatePrice("30dayPriceHvo", "30dayPriceDiesel", thirtyDaysAgo, true);
    updateAggregatePrice("30dayPriceHvoExVAT", "30dayPriceDieselExVAT", thirtyDaysAgo, false);

    const monthNames = [
      "januari",
      "februari",
      "mars",
      "april",
      "maj",
      "juni",
      "juli",
      "augusti",
      "september",
      "oktober",
      "november",
      "december",
    ];

    let currentMonth = monthNames[now.getMonth()];

    const avgHeader = document.getElementById("avgHeader");
    if (avgHeader) {
      avgHeader.innerText = currentMonth.charAt(0).toUpperCase() + currentMonth.slice(1) + " " + now.getFullYear();
    }

    const monthBefore = document.getElementById("monthBefore");
    const monthAfter = document.getElementById("monthAfter");
    if (monthBefore) monthBefore.addEventListener("click", selectPreviousMonth);
    if (monthAfter) monthAfter.addEventListener("click", selectNextMonth);

    let graphDuration = 30;

    function selectPreviousMonth() {
      now.setMonth(now.getMonth() - 1);

      startOfMonth = new Date(now);
      startOfMonth.setDate(1);

      currentMonth = monthNames[now.getMonth()];

      const avgHeader = document.getElementById("avgHeader");
      if (avgHeader) {
        avgHeader.innerText = currentMonth.charAt(0).toUpperCase() + currentMonth.slice(1) + " " + now.getFullYear();
      }

      updateAggregatePrice("monthPriceHvo", "monthPriceDiesel", startOfMonth, true);
      updateAggregatePrice("monthPriceHvoExVAT", "monthPriceDieselExVAT", startOfMonth, false);

      getPlot();
    }

    function selectNextMonth() {
      const actualNow = new Date();
      if ((now.getMonth() < actualNow.getMonth() && now.getFullYear() <= actualNow.getFullYear()) || now.getFullYear() < actualNow.getFullYear()) {
        now.setMonth(now.getMonth() + 1);
      }

      startOfMonth = new Date(now);
      startOfMonth.setDate(1);

      currentMonth = monthNames[now.getMonth()];

      const avgHeader = document.getElementById("avgHeader");
      if (avgHeader) {
        avgHeader.innerText = currentMonth.charAt(0).toUpperCase() + currentMonth.slice(1) + " " + now.getFullYear();
      }

      updateAggregatePrice("monthPriceHvo", "monthPriceDiesel", startOfMonth, true);
      updateAggregatePrice("monthPriceHvoExVAT", "monthPriceDieselExVAT", startOfMonth, false);

      getPlot();
    }

    async function fetchPlotData(date: Date, endDate: Date, vat: boolean) {
      let monthResp = await fetch(
        `/api/price/${date.getFullYear()}-${
          date.getMonth() + 1
        }-${date.getDate()}/${endDate.getFullYear()}-${endDate.getMonth() + 1}-${endDate.getDate()}`,
      );
      if (monthResp.ok) {
        const latestData: any[] = await monthResp.json();
        
        // Separate traces for HVO and Diesel
        let hvoData = {
          x: [],
          y: [],
          mode: "lines",
          name: "HVO 100",
          line: { shape: "linear", color: "#ca7131", width: 3 },
        };
        
        let dieselData = {
          x: [],
          y: [],
          mode: "lines",
          name: "Diesel",
          line: { shape: "linear", color: "#9ca3af", width: 3 },
        };

        for (let i = 0; i < latestData.length; i++) {
          const dateStr = latestData[i].date;
          
          // HVO 100 data
          if (latestData[i].hvo100Price != null) {
            hvoData.x.push(dateStr);
            if (vat) {
              hvoData.y.push(latestData[i].hvo100Price);
            } else {
              hvoData.y.push(removeVAT(latestData[i].hvo100Price));
            }
          }
          
          // Diesel data
          if (latestData[i].dieselPrice != null) {
            dieselData.x.push(dateStr);
            if (vat) {
              dieselData.y.push(latestData[i].dieselPrice);
            } else {
              dieselData.y.push(removeVAT(latestData[i].dieselPrice));
            }
          }
        }

        return { hvoData, dieselData };
      } else {
        return { 
          hvoData: { x: [], y: [], mode: "lines", name: "HVO 100", line: { shape: "linear", color: "#ca7131", width: 3 } }, 
          dieselData: { x: [], y: [], mode: "lines", name: "Diesel", line: { shape: "linear", color: "#9ca3af", width: 3 } } 
        };
      }
    }

    async function getPlot() {
      let thirtyDaysAgo = new Date(now);
      thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - graphDuration);

      const btn30day = document.getElementById("graphWidth30");
      const btn90day = document.getElementById("graphWidth90");
      const btn365day = document.getElementById("graphWidth365");

      // Update button states
      [btn30day, btn90day, btn365day].forEach(btn => {
        if (btn) btn.classList.remove("active-graph-duration");
      });
      
      if (graphDuration === 30 && btn30day) {
        btn30day.classList.add("active-graph-duration");
      } else if (graphDuration === 90 && btn90day) {
        btn90day.classList.add("active-graph-duration");
      } else if (graphDuration === 365 && btn365day) {
        btn365day.classList.add("active-graph-duration");
      }

      const { hvoData, dieselData } = await fetchPlotData(thirtyDaysAgo, now, true);

      let data = [];
      // Only add traces if they have data
      if (hvoData.y.length > 0) data.push(hvoData);
      if (dieselData.y.length > 0) data.push(dieselData);

      let layout = {
        autosize: true,
        xaxis: {
          gridcolor: "#ffffff13",
          showgrid: true,
        },
        yaxis: {
          gridcolor: "#ffffff13",
          showgrid: true,
          title: {
            text: "SEK",
          }
        },
        margin: {
          l: 70,
          r: 50,
          b: 70,
          t: 50,
          pad: 5,
        },
        paper_bgcolor: "rgba(0, 0, 0, 0)",
        plot_bgcolor: "rgba(0, 0, 0, 0)",
        font: {
          color: "#ca7131",
          family: "REM",
          size: 16,
        },
        separators: ",",
        showlegend: true,
        legend: {
          x: 0.02,
          y: 0.98,
          bgcolor: "rgba(40, 40, 40, 0.8)",
          bordercolor: "#ca7131",
          borderwidth: 1,
        },
      };

      Plotly.newPlot("priceHistory", data, layout, {
        responsive: true,
        displaylogo: false,
        displayModeBar: false,
      });
    }

    getPlot();

    const btn30day = document.getElementById("graphWidth30");
    const btn90day = document.getElementById("graphWidth90");
    const btn365day = document.getElementById("graphWidth365");
    
    if (btn30day) {
      btn30day.addEventListener("click", () => {
        graphDuration = 30;
        getPlot();
      });
    }
    if (btn90day) {
      btn90day.addEventListener("click", () => {
        graphDuration = 90;
        getPlot();
      });
    }
    if (btn365day) {
      btn365day.addEventListener("click", () => {
        graphDuration = 365;
        getPlot();
      });
    }
  </script>

  <style>
    .banner {
